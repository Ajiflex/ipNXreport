# ---- MongoDB ----
MONGODB_URI=
MONGODB_DB_NAME=ipnx_report

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production: https://<your-app>.vercel.app/api/auth/google/callback
# Local dev:  http://localhost:3000/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# ---- Drive ----
# PERMANENT discovery root: every monthly outage workbook (Google Sheets or
# Excel) placed inside this Drive folder is discovered automatically on the
# next sync — no per-month sharing, uploads, or source IDs needed.
GOOGLE_OPERATIONAL_FOLDER_ID=1cgqmTjaUkligPALcp-_I2qbySx48zxl4
# Optional: seeded during one-time setup, NOT hard-coded
OPERATIONAL_SHEET_ID=
GOOGLE_ARCHIVE_FOLDER_ID=

# ---- Platform security ----
CRON_SECRET=
# 32-byte hex (64 chars), used to AES-encrypt the stored refresh token
TOKEN_ENCRYPTION_KEY=
APP_BASE_URL=
# Optional internal-access gate — when set, mutating APIs require X-Api-Key
APP_API_KEY=
